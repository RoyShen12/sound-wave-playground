{
  "source": {
    "include": ["src/"],
    "includePattern": ".js$",
    "exclude": ["src/styles.css"]
  },
  "opts": {
    "destination": "docs/api",
    "recurse": true,
    "readme": "README.md"
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": true
    }
  },
  "plugins": ["plugins/markdown"]
}
