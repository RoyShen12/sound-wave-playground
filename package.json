{
  "name": "sound-wave-playground",
  "version": "1.0.0",
  "description": "基于 Web Audio API 的音频可视化与分析系统",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "docs": "jsdoc -c jsdoc.config.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoyShen12/sound-wave-playground.git"
  },
  "keywords": [
    "web-audio",
    "visualization",
    "dsp",
    "fourier-transform"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdoc": "^4.0.5",
    "prettier": "^3.8.1",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  }
}
